  fhir:language [ fhir:v "fr"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"fr\" lang=\"fr\"><hr/><p><b>French</b></p><hr/><p class=\"res-header-id\"><b>Narratif généré : CodeSystem SpenserUnitProperty</b></p><a name=\"fr-SpenserUnitProperty\"> </a><a name=\"fr-hcSpenserUnitProperty\"> </a><p>This case-sensitive code system <code>http://costateixeira.github.io/spenser/CodeSystem/SpenserUnitProperty</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Affichage</b></td><td><b>Définition</b></td></tr><tr><td style=\"white-space:nowrap\">server-url<a name=\"fr-SpenserUnitProperty-server-url\"> </a></td><td>Order server</td><td>The FHIR base URL the unit polls for orders.</td></tr><tr><td style=\"white-space:nowrap\">order-mode<a name=\"fr-SpenserUnitProperty-order-mode\"> </a></td><td>Order mode</td><td>Which routes make an order actionable for this unit: both, tag or task.</td></tr><tr><td style=\"white-space:nowrap\">order-query<a name=\"fr-SpenserUnitProperty-order-query\"> </a></td><td>Order search</td><td>Extra search parameters for tagged orders.</td></tr><tr><td style=\"white-space:nowrap\">task-query<a name=\"fr-SpenserUnitProperty-task-query\"> </a></td><td>Task search</td><td>Extra search parameters for Tasks.</td></tr><tr><td style=\"white-space:nowrap\">poll-enabled<a name=\"fr-SpenserUnitProperty-poll-enabled\"> </a></td><td>Polling</td><td>Whether the unit checks the order server on its own.</td></tr><tr><td style=\"white-space:nowrap\">poll-seconds<a name=\"fr-SpenserUnitProperty-poll-seconds\"> </a></td><td>Poll interval</td><td>Seconds between checks.</td></tr><tr><td style=\"white-space:nowrap\">write-back<a name=\"fr-SpenserUnitProperty-write-back\"> </a></td><td>Write back</td><td>Whether the unit reports dispenses and closes orders on the server.</td></tr><tr><td style=\"white-space:nowrap\">give-up-on-stock-empty<a name=\"fr-SpenserUnitProperty-give-up-on-stock-empty\"> </a></td><td>Give up when empty</td><td>Whether an order for an empty lane is abandoned rather than retried after a refill.</td></tr><tr><td style=\"white-space:nowrap\">update-mode<a name=\"fr-SpenserUnitProperty-update-mode\"> </a></td><td>Update mode</td><td>notify, or install firmware updates on its own.</td></tr><tr><td style=\"white-space:nowrap\">update-check-minutes<a name=\"fr-SpenserUnitProperty-update-check-minutes\"> </a></td><td>Update check interval</td><td>Minutes between looks at the release manifest.</td></tr><tr><td style=\"white-space:nowrap\">stock-dark<a name=\"fr-SpenserUnitProperty-stock-dark\"> </a></td><td>Dark stock</td><td>Pieces of dark chocolate the unit believes it holds.</td></tr><tr><td style=\"white-space:nowrap\">stock-milk<a name=\"fr-SpenserUnitProperty-stock-milk\"> </a></td><td>Milk stock</td><td>Pieces of milk chocolate the unit believes it holds.</td></tr><tr><td style=\"white-space:nowrap\">last-check<a name=\"fr-SpenserUnitProperty-last-check\"> </a></td><td>Last check</td><td>What the last order check reported.</td></tr><tr><td style=\"white-space:nowrap\">last-configuration<a name=\"fr-SpenserUnitProperty-last-configuration\"> </a></td><td>Last configuration</td><td>What the last configuration Task did.</td></tr><tr><td style=\"white-space:nowrap\">ssid<a name=\"fr-SpenserUnitProperty-ssid\"> </a></td><td>Wi-Fi network</td><td>The Wi-Fi network the unit is on.</td></tr><tr><td style=\"white-space:nowrap\">ip-address<a name=\"fr-SpenserUnitProperty-ip-address\"> </a></td><td>IP address</td><td>The unit's address on its own network.</td></tr><tr><td style=\"white-space:nowrap\">rssi<a name=\"fr-SpenserUnitProperty-rssi\"> </a></td><td>Signal</td><td>Wi-Fi signal strength, in dBm.</td></tr><tr><td style=\"white-space:nowrap\">largest-free-block<a name=\"fr-SpenserUnitProperty-largest-free-block\"> </a></td><td>Largest free block</td><td>The largest block of free memory, in bytes. A TLS connection needs about 40 KB in one piece.</td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
