     fhir:definition [ fhir:v "What the last order check reported." ]
  ] [
     fhir:code [ fhir:v "last-configuration" ] ;
     fhir:display [ fhir:v "Last configuration" ] ;
     fhir:definition [ fhir:v "What the last configuration Task did." ]
  ] [
     fhir:code [ fhir:v "ssid" ] ;
     fhir:display [ fhir:v "Wi-Fi network" ] ;
     fhir:definition [ fhir:v "The Wi-Fi network the unit is on." ]
  ] [
     fhir:code [ fhir:v "ip-address" ] ;
     fhir:display [ fhir:v "IP address" ] ;
     fhir:definition [ fhir:v "The unit's address on its own network." ]
  ] [
     fhir:code [ fhir:v "rssi" ] ;
     fhir:display [ fhir:v "Signal" ] ;
     fhir:definition [ fhir:v "Wi-Fi signal strength, in dBm." ]
  ] [
