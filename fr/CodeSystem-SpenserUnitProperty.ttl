  ] [
     fhir:code [ fhir:v "poll-seconds" ] ;
     fhir:display [ fhir:v "Poll interval" ] ;
     fhir:definition [ fhir:v "Seconds between checks." ]
  ] [
     fhir:code [ fhir:v "write-back" ] ;
     fhir:display [ fhir:v "Write back" ] ;
     fhir:definition [ fhir:v "Whether the unit reports dispenses and closes orders on the server." ]
  ] [
     fhir:code [ fhir:v "give-up-on-stock-empty" ] ;
     fhir:display [ fhir:v "Give up when empty" ] ;
     fhir:definition [ fhir:v "Whether an order for an empty lane is abandoned rather than retried after a refill." ]
  ] [
     fhir:code [ fhir:v "update-mode" ] ;
     fhir:display [ fhir:v "Update mode" ] ;
     fhir:definition [ fhir:v "notify, or install firmware updates on its own." ]
  ] [
     fhir:code [ fhir:v "update-check-minutes" ] ;
     fhir:display [ fhir:v "Update check interval" ] ;
     fhir:definition [ fhir:v "Minutes between looks at the release manifest." ]
  ] [
     fhir:code [ fhir:v "stock-dark" ] ;
     fhir:display [ fhir:v "Dark stock" ] ;
     fhir:definition [ fhir:v "Pieces of dark chocolate the unit believes it holds." ]
  ] [
     fhir:code [ fhir:v "stock-milk" ] ;
     fhir:display [ fhir:v "Milk stock" ] ;
     fhir:definition [ fhir:v "Pieces of milk chocolate the unit believes it holds." ]
  ] [
     fhir:code [ fhir:v "last-check" ] ;
