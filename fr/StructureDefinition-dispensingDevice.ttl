       fhir:isSummary [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "N/A" ]
       ] )
     ] )
  ] ; # 
  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Extension" ] ;
       fhir:path [ fhir:v "Extension" ] ;
       fhir:short [ fhir:v "Dispensing device" ] ;
       fhir:definition [ fhir:v "The Spenser unit that is to dispense this order, named by a logical reference: the unit's identifier in http://costateixeira.github.io/spenser/unit, which is its name, Spenser- and the last two bytes of its factory MAC.\n\nR5 has no element on MedicationRequest for this. MedicationRequest.performer and MedicationRequest.device take a DeviceDefinition, a kind of device, and dispenseRequest.dispenser takes only an Organization. A logical reference needs nothing on the server: the unit does not have to be registered as a Device for the order to name it.\n\nWhen a Task makes the order actionable, a Device in Task.requestedPerformer takes precedence over this extension. On an order with no Task, or a Task that names no unit, a unit acts on this extension: it skips an order that names another unit." ]
     ] [
       fhir:id [ fhir:v "Extension.extension" ] ;
       fhir:path [ fhir:v "Extension.extension" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Extension.url" ] ;
       fhir:path [ fhir:v "Extension.url" ] ;
       fhir:fixed [
         a fhir:uri ;
         fhir:v "http://costateixeira.github.io/spenser/StructureDefinition/dispensingDevice"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Extension.value[x]" ] ;
       fhir:path [ fhir:v "Extension.value[x]" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Reference"^^xsd:anyURI ] ;
         fhir:targetProfile ( [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Device"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Device>
         ] )
       ] )
     ] [
       fhir:id [ fhir:v "Extension.value[x].reference" ] ;
       fhir:path [ fhir:v "Extension.value[x].reference" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Extension.value[x].identifier" ] ;
       fhir:path [ fhir:v "Extension.value[x].identifier" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Extension.value[x].identifier.system" ] ;
       fhir:path [ fhir:v "Extension.value[x].identifier.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:fixed [
         a fhir:uri ;
         fhir:v "http://costateixeira.github.io/spenser/unit"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Extension.value[x].identifier.value" ] ;
       fhir:path [ fhir:v "Extension.value[x].identifier.value" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] )
  ] . # 

