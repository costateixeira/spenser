      <name value="Exemple - Ordonnance Spenser"/>
      <description value="Exemple de MedicationRequest à envoyer à Spenser"/>
      <isExample value="true"/>
      <profile value="http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="MedicationRequest"/>
      </extension>
      <reference>
        <reference value="MedicationRequest/ActionableDarkOrderForOneUnit"/>
      </reference>
      <name value="Example - Tagged order for one unit"/>
      <description value="An order made actionable by the tag, with no Task, that names the unit to dispense it in the dispensingDevice extension. Every other unit polling the server skips it."/>
      <isExample value="true"/>
      <profile value="http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
      </extension>
      <reference>
        <reference value="Task/FulfillForOneUnit"/>
      </reference>
      <name value="Example - Task addressed to one unit"/>
      <description value="Task.requestedPerformer names the unit that is to fill the order: the one Task element R5 lets name a Device. Every other unit skips this Task; the unit it names dispenses it and closes it."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
