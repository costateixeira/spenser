      <reference>
        <reference value="Task/FulfillPlainMilkOrder"/>
      </reference>
      <name value="Exemple - Task demandant l'exécution d'une ordonnance"/>
      <description value="Une Task de coordination qui pointe vers l'ordonnance dans Task.focus. C'est ce qui rend l'ordonnance simple exécutable. Spenser termine la Task avec la dispensation dans Task.output, et laisse la demande elle-même à l'émetteur."/>
      <isExample value="true"/>
    </resource>
