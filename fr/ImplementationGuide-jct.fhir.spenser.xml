      <reference>
        <reference value="StructureDefinition/dispensingDevice"/>
      </reference>
      <name value="Dispensing device"/>
      <description value="The Spenser unit that is to dispense this order, named by a logical reference: the unit's identifier in http://costateixeira.github.io/spenser/unit, which is its name, Spenser- and the last two bytes of its factory MAC.&#xA;&#xA;R5 has no element on MedicationRequest for this. MedicationRequest.performer and MedicationRequest.device take a DeviceDefinition, a kind of device, and dispenseRequest.dispenser takes only an Organization. A logical reference needs nothing on the server: the unit does not have to be registered as a Device for the order to name it.&#xA;&#xA;When a Task makes the order actionable, a Device in Task.requestedPerformer takes precedence over this extension. On an order with no Task, or a Task that names no unit, a unit acts on this extension: it skips an order that names another unit."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Device"/>
      </extension>
      <reference>
        <reference value="Device/Spenser-E3D4"/>
      </reference>
      <name value="Example - A Spenser unit on the order server"/>
      <description value="The Device a unit writes on the order server once per boot. Its id is the unit's name, the network it shows in setup mode: Spenser- and the last two bytes of its factory MAC."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="InventoryReport"/>
      </extension>
      <reference>
        <reference value="InventoryReport/Add5Milk"/>
      </reference>
      <name value="Exemple - Ajout au stock - 5 chocolats au lait"/>
      <description value="Exemple - Ajout au stock - 5 chocolats au lait"/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="MedicationDispense"/>
      </extension>
      <reference>
        <reference value="MedicationDispense/DispenseForDirectOrder"/>
      </reference>
      <name value="Example - Dispense answering an order posted at the unit"/>
      <description value="What a unit returns to an order posted straight at it. The chocolate is already out by the time the placer reads this."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="MedicationDispense"/>
      </extension>
      <reference>
        <reference value="MedicationDispense/DispenseForActionableDarkOrder"/>
      </reference>
      <name value="Exemple - Dispensation signalée en retour"/>
      <description value="Ce que Spenser crée sur le serveur d'ordonnances une fois qu'un morceau est sorti, en renvoyant à l'ordonnance dans authorizingPrescription. La même ressource est la réponse à une ordonnance envoyée directement à l'appareil."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="MedicationDispense"/>
      </extension>
      <reference>
        <reference value="MedicationDispense/DispenseForTaskOrder"/>
      </reference>
      <name value="Example - Dispense reported for a Task"/>
      <description value="What a unit creates on the order server once a Task has asked it to fill an order. The same resource goes into Task.output when the unit completes the Task."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="MedicationDispense"/>
      </extension>
      <reference>
        <reference value="MedicationDispense/DeclinedDispenseOutOfStock"/>
      </reference>
      <name value="Exemple - Dispensation qui n'a pas eu lieu"/>
      <description value="Une ordonnance que Spenser n'a pas pu exécuter parce que le couloir est vide. R5 a supprimé MedicationDispense.statusReason : le motif se trouve donc dans notPerformedReason, qui est un CodeableReference - d'où le .concept dans le chemin."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="MedicationRequest"/>
      </extension>
      <reference>
        <reference value="MedicationRequest/ActionableDarkOrder"/>
      </reference>
      <name value="Exemple - Ordonnance rendue exécutable par un tag"/>
      <description value="Une MedicationRequest que l'émetteur a marquée comme exécutable. Spenser la dispense à sa prochaine vérification et, comme aucune Task ne coordonne le travail, passe lui-même la demande à completed."/>
      <isExample value="true"/>
      <profile value="http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"/>
    </resource>
