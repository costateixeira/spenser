  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"fr\" lang=\"fr\"><hr/><p><b>French</b></p><hr/><p class=\"res-header-id\"><b>Narratif généré : ActorDefinition OrderPlacer</b></p><a name=\"fr-OrderPlacer\"> </a><a name=\"fr-hcOrderPlacer\"> </a><table class=\"grid\"><tr><td><b>Acteur : OrderPlacer </b></td><td>Émetteur d'ordonnances</td><td>Type : system </td></tr><tr><td colspan=\"3\"><div><p>Sur un serveur d'ordonnances, l'émetteur décide si une ordonnance est exécutable, soit en apposant un tag sur la MedicationRequest, soit en créant une Task qui pointe vers elle. Quand une Task coordonne le travail, l'émetteur clôture aussi la MedicationRequest une fois la Task terminée.</p>\n</div></td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "http://costateixeira.github.io/spenser/ActorDefinition/OrderPlacer"^^xsd:anyURI] ; # 
