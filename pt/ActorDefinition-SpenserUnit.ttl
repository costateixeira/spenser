<http://costateixeira.github.io/spenser/ActorDefinition/SpenserUnit> a fhir:ActorDefinition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "SpenserUnit"] ; # 
  fhir:language [ fhir:v "pt"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"pt\" lang=\"pt\"><hr/><p><b>Portuguese</b></p><hr/><p class=\"res-header-id\"><b>Narrativa gerada: ActorDefinition SpenserUnit</b></p><a name=\"pt-SpenserUnit\"> </a><a name=\"pt-hcSpenserUnit\"> </a><table class=\"grid\"><tr><td><b>Actor: SpenserUnit </b></td><td>Unidade Spenser</td><td>Tipo: system </td></tr><tr><td colspan=\"3\"><div><p>A single dispenser. As a <strong>server</strong> it accepts an order posted straight at it and dispenses on the spot, because posting to the device is itself the authorization to dispense. As a <strong>client</strong> it polls an Order Server, acts only on orders that have been made actionable, and reports back what it did.</p>\n<p>See <a href=\"interfaces.html\">Interfaces</a>.</p>\n</div></td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "http://costateixeira.github.io/spenser/ActorDefinition/SpenserUnit"^^xsd:anyURI] ; # 
