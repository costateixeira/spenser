      </reference>
      <name value="Example - Order meant for one unit"/>
      <description value="A plain order, made actionable by the Task that addresses it to one unit. The order names the unit too, in the dispensingDevice extension, by a logical reference: R5 has no element on MedicationRequest that takes a Device."/>
      <isExample value="true"/>
      <profile value="http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"/>
    </resource>
    <resource>
