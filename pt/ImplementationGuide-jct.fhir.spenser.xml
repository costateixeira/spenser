      </reference>
      <name value="Exemplo - Prescrição que não é acionável por si só"/>
      <description value="A mesma prescrição sem a tag. Por si só, é uma autorização e nada mais: o Spenser ignora-a até que uma Task peça que seja aviada."/>
      <isExample value="true"/>
      <profile value="http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"/>
    </resource>
