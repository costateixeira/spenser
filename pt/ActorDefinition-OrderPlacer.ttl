  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"pt\" lang=\"pt\"><hr/><p><b>Portuguese</b></p><hr/><p class=\"res-header-id\"><b>Narrativa gerada: ActorDefinition OrderPlacer</b></p><a name=\"pt-OrderPlacer\"> </a><a name=\"pt-hcOrderPlacer\"> </a><table class=\"grid\"><tr><td><b>Actor: OrderPlacer </b></td><td>Emissor de Prescrições</td><td>Tipo: system </td></tr><tr><td colspan=\"3\"><div><p>Num Servidor de Prescrições, o emissor decide se uma prescrição é acionável, quer colocando uma tag na MedicationRequest, quer criando uma Task que aponte para ela. Quando é uma Task a coordenar o trabalho, o emissor também fecha a MedicationRequest depois de a Task estar concluída.</p>\n</div></td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "http://costateixeira.github.io/spenser/ActorDefinition/OrderPlacer"^^xsd:anyURI] ; # 
