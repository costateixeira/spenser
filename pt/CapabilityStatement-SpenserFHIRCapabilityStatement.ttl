@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://costateixeira.github.io/spenser/CapabilityStatement/SpenserFHIRCapabilityStatement> a fhir:CapabilityStatement ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "SpenserFHIRCapabilityStatement"] ; # 
  fhir:language [ fhir:v "pt"] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"pt\" lang=\"pt\"><hr/><p><b>Portuguese</b></p><hr/><p class=\"res-header-id\"><b>Narrativa gerada: CapabilityStatement SpenserFHIRCapabilityStatement</b></p><a name=\"pt-SpenserFHIRCapabilityStatement\"> </a><a name=\"pt-hcSpenserFHIRCapabilityStatement\"> </a><h2 id=\"pt-title\"/><ul><li>Guia de implementação Versão: 1.0.0 </li><li>Versão FHIR: 5.0.0 </li><li>Formatos suportados: <code>json</code></li><li>Publicado em: 2025-04-18 </li><li>Publicado por: José Costa Teixeira </li></ul><blockquote class=\"impl-note\"><p><strong>Nota para os implementadores: Capacidades FHIR</strong></p><p>Qualquer capacidade FHIR pode ser \"permitida\" pelo sistema, exceto se for explicitamente assinalada como \"NÃO DEVE\". Alguns itens são marcados como MAY no Guia de Implementação para destacar a sua potencial relevância para o caso de utilização.</p></blockquote><h2 id=\"pt-rest\">Capacidades FHIR RESTful</h2><h3 id=\"pt-rest1\">Configuração REST: 1 </h3><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"pt-mode1\" class=\"panel-title\">Mode: <code>server</code></h4></div><div class=\"panel-body\"/></div><h4 id=\"pt-resourcesCap1\">Capacidades por recurso/perfil</h4><h5 id=\"pt-resourcesSummary1\">Resumo</h5><p>A tabela de resumo enumera os recursos que fazem parte desta configuração e, para cada recurso, enumera-os:</p><ul><li>Os perfis relevantes (se existirem)</li><li>As interações suportadas por cada recurso (<b><span class=\"bg-info\">R</span></b>ead, <b><span class=\"bg-info\">S</span></b>earch, <b><span class=\"bg-info\">U</span></b>pdate, and <b><span class=\"bg-info\">C</span></b>reate, are always shown, while <b><span class=\"bg-info\">VR</span></b>ead, <b><span class=\"bg-info\">P</span></b>atch, <b><span class=\"bg-info\">D</span></b>elete, <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">I</span></b>nstance, or <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">T</span></b>só estão presentes se pelo menos um dos recursos os suportar.</li><li><span>Os parâmetros de pesquisa obrigatórios, recomendados e alguns opcionais (se existirem). </span></li><li>Os recursos ligados activados para <code>_include</code></li><li>Os outros recursos activados para <code>_revinclude</code></li><li>As operações sobre o recurso (se existirem)</li></ul><div class=\"table-responsive\"><table class=\"table table-condensed table-hover\"><thead><tr><th><b>Tipo de recurso</b></th><th><b>Perfil</b></th><th class=\"text-center\"><b title=\"GET um recurso (interação de leitura)\">R</b></th><th class=\"text-center\"><b title=\"GET todo o conjunto de recursos do tipo (interação de pesquisa)\">S</b></th><th class=\"text-center\"><b title=\"PUT uma nova versão do recurso (interação de atualização)\">U</b></th><th class=\"text-center\"><b title=\"POST um novo recurso (criar interação)\">C</b></th><th><b title=\"Parâmetros de pesquisa necessários e recomendados\">Pesquisas</b></th><th><code><b>_include</b></code></th><th><code><b>_revinclude</b></code></th><th><b>Operações</b></th></tr></thead><tbody><tr><td><a href=\"#pt-MedicationRequest1-1\">MedicationRequest</a></td><td> </td><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\">y</td><td/><td/><td/><td/></tr><tr><td><a href=\"#pt-MedicationDispense1-2\">MedicationDispense</a></td><td> </td><td class=\"text-center\">y</td><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\"/><td/><td/><td/><td/></tr><tr><td><a href=\"#pt-InventoryReport1-3\">InventoryReport</a></td><td> </td><td class=\"text-center\">y</td><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\">y</td><td/><td/><td/><td/></tr></tbody></table></div><hr/><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"pt-MedicationRequest1-1\" class=\"panel-title\"><span style=\"float: right;\">Conformidade do recurso: unspecified </span>MedicationRequest</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Recurso FHIR principal</span><br/><a href=\"http://hl7.org/fhir/medicationrequest.html\">MedicationRequest</a></div><div class=\"col-lg-4\"><span class=\"lead\">Política de referência</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Resumo da interação</span><br/><ul><li>Apoios <code>create</code>.</li></ul></div></div><p/><p/></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"pt-MedicationDispense1-2\" class=\"panel-title\"><span style=\"float: right;\">Conformidade do recurso: unspecified </span>MedicationDispense</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Recurso FHIR principal</span><br/><a href=\"http://hl7.org/fhir/medicationdispense.html\">MedicationDispense</a></div><div class=\"col-lg-4\"><span class=\"lead\">Política de referência</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Resumo da interação</span><br/><ul><li>Apoios <code>read</code>.</li></ul></div></div><p/><p/></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"pt-InventoryReport1-3\" class=\"panel-title\"><span style=\"float: right;\">Conformidade do recurso: unspecified </span>InventoryReport</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Recurso FHIR principal</span><br/><a href=\"http://hl7.org/fhir/inventoryreport.html\">InventoryReport</a></div><div class=\"col-lg-4\"><span class=\"lead\">Política de referência</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Resumo da interação</span><br/><ul><li>Apoios <code>read</code>, <code>create</code>.</li></ul></div></div><p/><p/></div></div></div><h3 id=\"pt-rest2\">Configuração REST: 2 </h3><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"pt-mode2\" class=\"panel-title\">Mode: <code>client</code></h4></div><div class=\"panel-body\"><div><p>Spenser also acts as a client: it polls a server for orders it should fulfil. Following the COW guidance on actionable orders, an order is only dispensed when the MedicationRequest carries the 'actionable' tag, or when a Task asks for it to be fulfilled.</p>\n</div></div></div><h4 id=\"pt-resourcesCap2\">Capacidades por recurso/perfil</h4><h5 id=\"pt-resourcesSummary2\">Resumo</h5><p>A tabela de resumo enumera os recursos que fazem parte desta configuração e, para cada recurso, enumera-os:</p><ul><li>Os perfis relevantes (se existirem)</li><li>As interações suportadas por cada recurso (<b><span class=\"bg-info\">R</span></b>ead, <b><span class=\"bg-info\">S</span></b>earch, <b><span class=\"bg-info\">U</span></b>pdate, and <b><span class=\"bg-info\">C</span></b>reate, are always shown, while <b><span class=\"bg-info\">VR</span></b>ead, <b><span class=\"bg-info\">P</span></b>atch, <b><span class=\"bg-info\">D</span></b>elete, <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">I</span></b>nstance, or <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">T</span></b>só estão presentes se pelo menos um dos recursos os suportar.</li><li><span>Os parâmetros de pesquisa obrigatórios, recomendados e alguns opcionais (se existirem). </span></li><li>Os recursos ligados activados para <code>_include</code></li><li>Os outros recursos activados para <code>_revinclude</code></li><li>As operações sobre o recurso (se existirem)</li></ul><div class=\"table-responsive\"><table class=\"table table-condensed table-hover\"><thead><tr><th><b>Tipo de recurso</b></th><th><b>Perfil</b></th><th class=\"text-center\"><b title=\"GET um recurso (interação de leitura)\">R</b></th><th class=\"text-center\"><b title=\"GET todo o conjunto de recursos do tipo (interação de pesquisa)\">S</b></th><th class=\"text-center\"><b title=\"PUT uma nova versão do recurso (interação de atualização)\">U</b></th><th class=\"text-center\"><b title=\"POST um novo recurso (criar interação)\">C</b></th><th><b title=\"Parâmetros de pesquisa necessários e recomendados\">Pesquisas</b></th><th><code><b>_include</b></code></th><th><code><b>_revinclude</b></code></th><th><b>Operações</b></th></tr></thead><tbody><tr><td><a href=\"#pt-MedicationRequest2-1\">MedicationRequest</a></td><td> </td><td class=\"text-center\"/><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\"/><td>_tag, status, intent</td><td/><td/><td/></tr><tr><td><a href=\"#pt-Task2-2\">Task</a></td><td> </td><td class=\"text-center\"/><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\"/><td>status</td><td><code>Task:focus</code></td><td/><td/></tr><tr><td><a href=\"#pt-MedicationDispense2-3\">MedicationDispense</a></td><td> </td><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\">y</td><td/><td/><td/><td/></tr></tbody></table></div><hr/><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"pt-MedicationRequest2-1\" class=\"panel-title\"><span style=\"float: right;\">Conformidade do recurso: unspecified </span>MedicationRequest</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Recurso FHIR principal</span><br/><a href=\"http://hl7.org/fhir/medicationrequest.html\">MedicationRequest</a></div><div class=\"col-lg-4\"><span class=\"lead\">Política de referência</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Resumo da interação</span><br/><ul><li>Apoios <code>search-type</code>, <code>update</code>.</li></ul></div></div><p/><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Documentação</span><blockquote><div><p>Searched for orders tagged as actionable. Set to 'completed' after dispensing, when no Task is coordinating the work.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Parâmetros de pesquisa</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Conformidade</th><th>Parâmetro</th><th>Tipo</th><th>Documentação</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td>_tag</td><td><code>token</code></td><td><div><p>Selects orders tagged http://terminology.hl7.org/CodeSystem/common-tags#actionable</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>status</td><td><code>token</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>intent</td><td><code>token</code></td><td><div/></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"pt-Task2-2\" class=\"panel-title\"><span style=\"float: right;\">Conformidade do recurso: unspecified </span>Task</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Recurso FHIR principal</span><br/><a href=\"http://hl7.org/fhir/task.html\">Task</a></div><div class=\"col-lg-4\"><span class=\"lead\">Política de referência</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Resumo da interação</span><br/><ul><li>Apoios <code>search-type</code>, <code>update</code>.</li></ul></div></div><p/><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Documentação</span><blockquote><div><p>Coordination Task pointing at the order in Task.focus. Set to 'completed' with the dispense in Task.output; the status of the request itself is left to the placer.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Parâmetros de pesquisa</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Conformidade</th><th>Parâmetro</th><th>Tipo</th><th>Documentação</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td>status</td><td><code>token</code></td><td><div/></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"pt-MedicationDispense2-3\" class=\"panel-title\"><span style=\"float: right;\">Conformidade do recurso: unspecified </span>MedicationDispense</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Recurso FHIR principal</span><br/><a href=\"http://hl7.org/fhir/medicationdispense.html\">MedicationDispense</a></div><div class=\"col-lg-4\"><span class=\"lead\">Política de referência</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Resumo da interação</span><br/><ul><li>Apoios <code>create</code>.</li></ul></div></div><p/><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Documentação</span><blockquote><div><p>Created on the server once an order has been dispensed, referring to the order in authorizingPrescription.</p>\n</div></blockquote></div></div></div></div></div></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "http://costateixeira.github.io/spenser/CapabilityStatement/SpenserFHIRCapabilityStatement"^^xsd:anyURI] ; # 
  fhir:version [ fhir:v "1.0.0"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:date [ fhir:v "2025-04-18"^^xsd:date] ; # 
  fhir:publisher [ fhir:v "José Costa Teixeira"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "José Costa Teixeira" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://github.com/costateixeira" ]
     ] )
  ] [
     fhir:name [ fhir:v "José Costa Teixeira" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "email" ] ;
       fhir:value [ fhir:v "you-know.it@gmail.com" ] ;
       fhir:use [ fhir:v "work" ]
     ] )
  ] ) ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:kind [ fhir:v "instance"] ; # 
  fhir:implementation [
     fhir:description [ fhir:v "Spenser FHIR Endpoint" ]
  ] ; # 
  fhir:fhirVersion [ fhir:v "5.0.0"] ; # 
  fhir:format ( [ fhir:v "json"] ) ; # 
  fhir:rest ( [
     fhir:mode [ fhir:v "server" ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "MedicationRequest" ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "create" ]
       ] )
     ] [
       fhir:type [ fhir:v "MedicationDispense" ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] )
     ] [
       fhir:type [ fhir:v "InventoryReport" ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "create" ]
       ] )
     ] )
  ] [
     fhir:mode [ fhir:v "client" ] ;
     fhir:documentation [ fhir:v "Spenser also acts as a client: it polls a server for orders it should fulfil. Following the COW guidance on actionable orders, an order is only dispensed when the MedicationRequest carries the 'actionable' tag, or when a Task asks for it to be fulfilled." ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "MedicationRequest" ] ;
       fhir:documentation [ fhir:v "Searched for orders tagged as actionable. Set to 'completed' after dispensing, when no Task is coordinating the work." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "search-type" ]
       ] [
         fhir:code [ fhir:v "update" ]
       ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "_tag" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Selects orders tagged http://terminology.hl7.org/CodeSystem/common-tags#actionable" ]
       ] [
         fhir:name [ fhir:v "status" ] ;
         fhir:type [ fhir:v "token" ]
       ] [
         fhir:name [ fhir:v "intent" ] ;
         fhir:type [ fhir:v "token" ]
       ] )
     ] [
       fhir:type [ fhir:v "Task" ] ;
       fhir:documentation [ fhir:v "Coordination Task pointing at the order in Task.focus. Set to 'completed' with the dispense in Task.output; the status of the request itself is left to the placer." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "search-type" ]
       ] [
         fhir:code [ fhir:v "update" ]
       ] ) ;
       fhir:searchInclude ( [ fhir:v "Task:focus" ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "status" ] ;
         fhir:type [ fhir:v "token" ]
       ] )
     ] [
       fhir:type [ fhir:v "MedicationDispense" ] ;
       fhir:documentation [ fhir:v "Created on the server once an order has been dispensed, referring to the order in authorizingPrescription." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "create" ]
       ] )
     ] )
  ] ) . # 

