  fhir:definition [
     fhir:extension ( [
       fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/ig-internal-dependency"^^xsd:anyURI ] ;
       fhir:value [
         a fhir:code ;
         fhir:v "hl7.fhir.uv.tools.r5#1.3.0"
       ]
     ] ) ;
     fhir:resource ( [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/StructureDefinition/dispensingDevice> ;
         fhir:reference [ fhir:v "StructureDefinition/dispensingDevice" ]
       ] ;
       fhir:name [ fhir:v "Dispensing device" ] ;
       fhir:description [ fhir:v "The Spenser unit that is to dispense this order, named by a logical reference: the unit's identifier in http://costateixeira.github.io/spenser/unit, which is its name, Spenser- and the last two bytes of its factory MAC.\n\nR5 has no element on MedicationRequest for this. MedicationRequest.performer and MedicationRequest.device take a DeviceDefinition, a kind of device, and dispenseRequest.dispenser takes only an Organization. A logical reference needs nothing on the server: the unit does not have to be registered as a Device for the order to name it.\n\nWhen a Task makes the order actionable, a Device in Task.requestedPerformer takes precedence over this extension. On an order with no Task, or a Task that names no unit, a unit acts on this extension: it skips an order that names another unit." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Device"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/Device/Spenser-E3D4> ;
         fhir:reference [ fhir:v "Device/Spenser-E3D4" ]
       ] ;
       fhir:name [ fhir:v "Example - A Spenser unit on the order server" ] ;
       fhir:description [ fhir:v "The Device a unit writes on the order server once per boot. Its id is the unit's name, the network it shows in setup mode: Spenser- and the last two bytes of its factory MAC." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "InventoryReport"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/InventoryReport/Add5Milk> ;
         fhir:reference [ fhir:v "InventoryReport/Add5Milk" ]
       ] ;
       fhir:name [ fhir:v "Exemplo - Acrescentar ao inventário - 5 chocolates de leite" ] ;
       fhir:description [ fhir:v "Exemplo - Acrescentar ao inventário - 5 chocolates de leite" ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationDispense"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationDispense/DispenseForDirectOrder> ;
         fhir:reference [ fhir:v "MedicationDispense/DispenseForDirectOrder" ]
       ] ;
       fhir:name [ fhir:v "Example - Dispense answering an order posted at the unit" ] ;
       fhir:description [ fhir:v "What a unit returns to an order posted straight at it. The chocolate is already out by the time the placer reads this." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationDispense"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationDispense/DispenseForActionableDarkOrder> ;
         fhir:reference [ fhir:v "MedicationDispense/DispenseForActionableDarkOrder" ]
       ] ;
       fhir:name [ fhir:v "Exemplo - Dispensa comunicada de volta" ] ;
       fhir:description [ fhir:v "O que o Spenser cria no servidor de prescrições depois de sair um pedaço, apontando de volta para a prescrição em authorizingPrescription. O mesmo recurso é a resposta a uma prescrição publicada diretamente no dispositivo." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationDispense"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationDispense/DispenseForTaskOrder> ;
         fhir:reference [ fhir:v "MedicationDispense/DispenseForTaskOrder" ]
       ] ;
       fhir:name [ fhir:v "Example - Dispense reported for a Task" ] ;
       fhir:description [ fhir:v "What a unit creates on the order server once a Task has asked it to fill an order. The same resource goes into Task.output when the unit completes the Task." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationDispense"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationDispense/DeclinedDispenseOutOfStock> ;
         fhir:reference [ fhir:v "MedicationDispense/DeclinedDispenseOutOfStock" ]
       ] ;
       fhir:name [ fhir:v "Exemplo - Dispensa que não aconteceu" ] ;
       fhir:description [ fhir:v "Uma prescrição que o Spenser não conseguiu aviar porque a calha está vazia. O R5 removeu MedicationDispense.statusReason, pelo que o motivo fica em notPerformedReason, que é um CodeableReference - daí o .concept no caminho." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationRequest"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationRequest/ActionableDarkOrder> ;
         fhir:reference [ fhir:v "MedicationRequest/ActionableDarkOrder" ]
       ] ;
       fhir:name [ fhir:v "Exemplo - Prescrição tornada acionável por uma tag" ] ;
       fhir:description [ fhir:v "Uma MedicationRequest que o emissor marcou como acionável. O Spenser dispensa-a na verificação seguinte e, como nenhuma Task está a coordenar o trabalho, define ele próprio a MedicationRequest como completed." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"^^xsd:anyURI ;
         fhir:link <http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationRequest"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationRequest/PlainDarkOrderForOneUnit> ;
         fhir:reference [ fhir:v "MedicationRequest/PlainDarkOrderForOneUnit" ]
       ] ;
       fhir:name [ fhir:v "Example - Order meant for one unit" ] ;
       fhir:description [ fhir:v "A plain order, made actionable by the Task that addresses it to one unit. The order names the unit too, in the dispensingDevice extension, by a logical reference: R5 has no element on MedicationRequest that takes a Device." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"^^xsd:anyURI ;
         fhir:link <http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationRequest"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationRequest/PlainMilkOrder> ;
         fhir:reference [ fhir:v "MedicationRequest/PlainMilkOrder" ]
       ] ;
       fhir:name [ fhir:v "Exemplo - Prescrição que não é acionável por si só" ] ;
       fhir:description [ fhir:v "A mesma prescrição sem a tag. Por si só, é uma autorização e nada mais: o Spenser ignora-a até que uma Task peça que seja aviada." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"^^xsd:anyURI ;
         fhir:link <http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "InventoryReport"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/InventoryReport/SetDarkTo17> ;
         fhir:reference [ fhir:v "InventoryReport/SetDarkTo17" ]
       ] ;
       fhir:name [ fhir:v "Exemplo - Definir inventário - 17 chocolates negros" ] ;
       fhir:description [ fhir:v "Exemplo - Definir inventário - 17 chocolates negros" ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationRequest"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationRequest/med-request-1234> ;
         fhir:reference [ fhir:v "MedicationRequest/med-request-1234" ]
       ] ;
       fhir:name [ fhir:v "Exemplo - Prescrição para o Spenser" ] ;
       fhir:description [ fhir:v "Exemplo de uma MedicationRequest a enviar ao Spenser" ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"^^xsd:anyURI ;
         fhir:link <http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "MedicationRequest"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/MedicationRequest/ActionableDarkOrderForOneUnit> ;
         fhir:reference [ fhir:v "MedicationRequest/ActionableDarkOrderForOneUnit" ]
       ] ;
       fhir:name [ fhir:v "Example - Tagged order for one unit" ] ;
       fhir:description [ fhir:v "An order made actionable by the tag, with no Task, that names the unit to dispense it in the dispensingDevice extension. Every other unit polling the server skips it." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"^^xsd:anyURI ;
         fhir:link <http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Task"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/Task/FulfillForOneUnit> ;
         fhir:reference [ fhir:v "Task/FulfillForOneUnit" ]
       ] ;
       fhir:name [ fhir:v "Example - Task addressed to one unit" ] ;
       fhir:description [ fhir:v "Task.requestedPerformer names the unit that is to fill the order: the one Task element R5 lets name a Device. Every other unit skips this Task; the unit it names dispenses it and closes it." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Task"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/Task/FulfillPlainMilkOrder> ;
         fhir:reference [ fhir:v "Task/FulfillPlainMilkOrder" ]
       ] ;
       fhir:name [ fhir:v "Exemplo - Task a pedir que uma prescrição seja aviada" ] ;
       fhir:description [ fhir:v "Uma Task de coordenação que aponta para a prescrição em Task.focus. É isto que torna acionável a prescrição simples. O Spenser conclui a Task com a dispensa em Task.output e deixa a própria MedicationRequest ao emissor." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ActorDefinition"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/ActorDefinition/OrderPlacer> ;
         fhir:reference [ fhir:v "ActorDefinition/OrderPlacer" ]
       ] ;
       fhir:name [ fhir:v "Emissor de Prescrições" ] ;
       fhir:description [ fhir:v "O sistema que pede chocolate, publicando uma prescrição numa Unidade Spenser ou emitindo-a num Servidor de Prescrições." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ActorDefinition"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/ActorDefinition/OrderServer> ;
         fhir:reference [ fhir:v "ActorDefinition/OrderServer" ]
       ] ;
       fhir:name [ fhir:v "Servidor de Prescrições" ] ;
       fhir:description [ fhir:v "Um servidor FHIR que guarda as prescrições até uma Unidade Spenser as recolher, e recebe o que a unidade comunica de volta." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ExampleScenario"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/ExampleScenario/DirectOrderScenario> ;
         fhir:reference [ fhir:v "ExampleScenario/DirectOrderScenario" ]
       ] ;
       fhir:name [ fhir:v "Scenario - Ordering straight from the unit" ] ;
       fhir:description [ fhir:v "A placer posts an order to a Spenser unit and gets back the dispense. No server, no Task, no tag: the POST is the authorization." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ExampleScenario"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/ExampleScenario/TaskOrderScenario> ;
         fhir:reference [ fhir:v "ExampleScenario/TaskOrderScenario" ]
       ] ;
       fhir:name [ fhir:v "Scenario - Ordering through an order server" ] ;
       fhir:description [ fhir:v "A placer puts an order and a Task on an order server. The unit polls the server, dispenses what is addressed to it, and reports back what it did." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/CodeSystem/SpenserMeds> ;
         fhir:reference [ fhir:v "CodeSystem/SpenserMeds" ]
       ] ;
       fhir:name [ fhir:v "Medicamentos Spenser - Sistema de códigos" ] ;
       fhir:description [ fhir:v "Um sistema de códigos dos medicamentos que o Spenser pode dispensar." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/ValueSet/SpenserMedsVS> ;
         fhir:reference [ fhir:v "ValueSet/SpenserMedsVS" ]
       ] ;
       fhir:name [ fhir:v "Medicamentos Spenser - Conjunto de valores" ] ;
       fhir:description [ fhir:v "Um conjunto de valores dos medicamentos que o Spenser pode dispensar." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ActorDefinition"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <http://costateixeira.github.io/spenser/ActorDefinition/SpenserUnit> ;
         fhir:reference [ fhir:v "ActorDefinition/SpenserUnit" ]
       ] ;
       fhir:name [ fhir:v "Unidade Spenser" ] ;
       fhir:description [ fhir:v "Um dispensador de chocolate, que atua como servidor FHIR e como cliente FHIR ao mesmo tempo." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CapabilityStatement"
         ]
