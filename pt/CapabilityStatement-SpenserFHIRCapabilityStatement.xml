  <kind value="instance"/>
  <implementation>
    <description value="Spenser FHIR Endpoint"/>
  </implementation>
  <fhirVersion value="5.0.0"/>
  <format value="json"/>
  <rest>
    <mode value="server"/>
    <resource>
      <type value="MedicationRequest"/>
      <interaction>
        <code value="create"/>
      </interaction>
    </resource>
    <resource>
      <type value="MedicationDispense"/>
      <interaction>
        <code value="read"/>
      </interaction>
    </resource>
    <resource>
      <type value="InventoryReport"/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="create"/>
      </interaction>
    </resource>
  </rest>
  <rest>
    <mode value="client"/>
    <documentation value="Spenser also acts as a client: it polls a server for orders it should fulfil. Following the COW guidance on actionable orders, an order is only dispensed when the MedicationRequest carries the 'actionable' tag, or when a Task asks for it to be fulfilled."/>
    <resource>
      <type value="MedicationRequest"/>
      <documentation value="Searched for orders tagged as actionable. Set to 'completed' after dispensing, when no Task is coordinating the work."/>
      <interaction>
        <code value="search-type"/>
      </interaction>
      <interaction>
        <code value="update"/>
      </interaction>
      <searchParam>
        <name value="_tag"/>
        <type value="token"/>
        <documentation value="Selects orders tagged http://terminology.hl7.org/CodeSystem/common-tags#actionable"/>
      </searchParam>
      <searchParam>
        <name value="status"/>
        <type value="token"/>
      </searchParam>
      <searchParam>
        <name value="intent"/>
        <type value="token"/>
      </searchParam>
    </resource>
    <resource>
      <type value="Task"/>
      <documentation value="Coordination Task pointing at the order in Task.focus. Set to 'completed' with the dispense in Task.output; the status of the request itself is left to the placer."/>
      <interaction>
        <code value="search-type"/>
      </interaction>
      <interaction>
        <code value="update"/>
      </interaction>
      <searchInclude value="Task:focus"/>
      <searchParam>
        <name value="status"/>
        <type value="token"/>
      </searchParam>
    </resource>
    <resource>
      <type value="MedicationDispense"/>
      <documentation value="Created on the server once an order has been dispensed, referring to the order in authorizingPrescription."/>
      <interaction>
        <code value="create"/>
      </interaction>
    </resource>
  </rest>
</CapabilityStatement>