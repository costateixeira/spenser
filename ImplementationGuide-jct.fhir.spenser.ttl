             ]
           ] [
             fhir:url [ fhir:v "content"^^xsd:anyURI ] ;
             fhir:value [
               a fhir:string ;
               fhir:v "Voorbeeld - Teruggemelde verstrekking"
             ]
           ] ) ;
           fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/translation"^^xsd:anyURI ]
         ] [
           fhir:extension ( [
             fhir:url [ fhir:v "lang"^^xsd:anyURI ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "fr"
             ]
           ] [
             fhir:url [ fhir:v "content"^^xsd:anyURI ] ;
