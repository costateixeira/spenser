             ]
           ] ) ;
           fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/translation"^^xsd:anyURI ]
         ] )
       ] ;
       fhir:description [
         fhir:v "What Spenser creates on the order server once a piece has come out, pointing back at the order in authorizingPrescription. The same resource is the answer to an order posted straight at the device." ;
         fhir:extension ( [
           fhir:extension ( [
             fhir:url [ fhir:v "lang"^^xsd:anyURI ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "pt"
             ]
           ] [
             fhir:url [ fhir:v "content"^^xsd:anyURI ] ;
             fhir:value [
               a fhir:string ;
               fhir:v "O que o Spenser cria no servidor de prescrições depois de sair um pedaço, apontando de volta para a prescrição em authorizingPrescription. O mesmo recurso é a resposta a uma prescrição publicada diretamente no dispositivo."
             ]
           ] ) ;
           fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/translation"^^xsd:anyURI ]
         ] [
           fhir:extension ( [
             fhir:url [ fhir:v "lang"^^xsd:anyURI ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "nl"
             ]
           ] [
             fhir:url [ fhir:v "content"^^xsd:anyURI ] ;
             fhir:value [
               a fhir:string ;
               fhir:v "Wat Spenser op de orderserver aanmaakt zodra er een stukje is uitgekomen, met in authorizingPrescription een verwijzing terug naar de order. Dezelfde resource is het antwoord op een order die rechtstreeks naar het apparaat wordt gepost."
             ]
           ] ) ;
           fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/translation"^^xsd:anyURI ]
         ] [
           fhir:extension ( [
             fhir:url [ fhir:v "lang"^^xsd:anyURI ] ;
             fhir:value [
               a fhir:code ;
               fhir:v "fr"
             ]
           ] [
             fhir:url [ fhir:v "content"^^xsd:anyURI ] ;
             fhir:value [
               a fhir:string ;
               fhir:v "Ce que Spenser crée sur le serveur d'ordonnances une fois qu'un morceau est sorti, en renvoyant à l'ordonnance dans authorizingPrescription. La même ressource est la réponse à une ordonnance envoyée directement à l'appareil."
             ]
           ] ) ;
           fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/translation"^^xsd:anyURI ]
         ] )
       ] ;
       fhir:isExample [ fhir:v true ]
