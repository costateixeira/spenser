     ] )
  ] ) ; # 
  fhir:description [ fhir:v "A placer puts an order and a Task on an order server. The unit polls the server, dispenses what is addressed to it, and reports back what it did."] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:purpose [ fhir:v "The long way round, and the one that behaves like a real workflow.\n\nAn order on a server is an authorization: it says a chocolate may be dispensed,\nnot that one should be dispensed now. Something else has to ask for it to be\nfulfilled. A Task is that something, and `Task.requestedPerformer` is the only\nplace in R5 that can name the Device meant to do the work.\n\nThe unit is never connected to from outside here. It polls, which is what lets\na dispenser sit on a conference network with nothing open to it."] ; # 
  fhir:actor ( [
     fhir:key [ fhir:v "placer" ] ;
     fhir:type [ fhir:v "system" ] ;
     fhir:title [ fhir:v "Order Placer" ] ;
     fhir:description [ fhir:v "Creates the order and the Task, and closes the order once the Task is done. A Task closes itself; a MedicationRequest does not." ]
  ] [
     fhir:key [ fhir:v "server" ] ;
     fhir:type [ fhir:v "system" ] ;
     fhir:title [ fhir:v "Order Server" ] ;
     fhir:description [ fhir:v "A plain FHIR server. It holds the order and the Task until a unit collects them, and it has to answer `_include=Task:focus`." ]
  ] [
     fhir:key [ fhir:v "spenser" ] ;
     fhir:type [ fhir:v "system" ] ;
     fhir:title [ fhir:v "Spenser Unit" ] ;
     fhir:description [ fhir:v "Acting here as a FHIR client. It takes only the work addressed to it and leaves everything else alone." ]
  ] ) ; # 
  fhir:instance ( [
     fhir:key [ fhir:v "order" ] ;
     fhir:structureType [
       fhir:system [ fhir:v "http://hl7.org/fhir/fhir-types"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "MedicationRequest" ]
     ] ;
     fhir:structureProfile [
       a fhir:canonical ;
       fhir:v "http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"^^xsd:anyURI ;
       fhir:link <http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest>
     ] ;
     fhir:title [ fhir:v "The order" ] ;
     fhir:description [ fhir:v "An untagged MedicationRequest, naming the unit meant to fill it in the `dispensingDevice` extension. On its own it sits there." ] ;
     fhir:content [
       fhir:link <http://costateixeira.github.io/spenser/MedicationRequest/PlainDarkOrderForOneUnit> ;
       fhir:reference [ fhir:v "MedicationRequest/PlainDarkOrderForOneUnit" ]
     ] ;
     fhir:version ( [
       fhir:key [ fhir:v "order-active" ] ;
       fhir:title [ fhir:v "active" ] ;
       fhir:description [ fhir:v "As created: authorized, and not yet filled." ] ;
       fhir:content [
         fhir:link <http://costateixeira.github.io/spenser/MedicationRequest/PlainDarkOrderForOneUnit> ;
         fhir:reference [ fhir:v "MedicationRequest/PlainDarkOrderForOneUnit" ]
       ]
     ] [
       fhir:key [ fhir:v "order-completed" ] ;
       fhir:title [ fhir:v "completed" ] ;
       fhir:description [ fhir:v "After the placer closes it. The unit does not touch the order while a Task is coordinating the work." ]
     ] )
  ] [
     fhir:key [ fhir:v "task" ] ;
     fhir:structureType [
       fhir:system [ fhir:v "http://hl7.org/fhir/fhir-types"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "Task" ]
     ] ;
     fhir:title [ fhir:v "The Task" ] ;
     fhir:description [ fhir:v "A `fulfill` Task whose `focus` is the order and whose `requestedPerformer` is the unit. This is what makes the order actionable." ] ;
     fhir:content [
       fhir:link <http://costateixeira.github.io/spenser/Task/FulfillForOneUnit> ;
       fhir:reference [ fhir:v "Task/FulfillForOneUnit" ]
     ] ;
     fhir:version ( [
       fhir:key [ fhir:v "task-requested" ] ;
       fhir:title [ fhir:v "requested" ] ;
       fhir:description [ fhir:v "As created. Every other unit polling the same server skips it." ] ;
       fhir:content [
         fhir:link <http://costateixeira.github.io/spenser/Task/FulfillForOneUnit> ;
         fhir:reference [ fhir:v "Task/FulfillForOneUnit" ]
       ]
     ] [
       fhir:key [ fhir:v "task-completed" ] ;
       fhir:title [ fhir:v "completed" ] ;
       fhir:description [ fhir:v "After the chocolate came out, with the dispense in `Task.output`." ]
     ] )
  ] [
     fhir:key [ fhir:v "dispense" ] ;
     fhir:structureType [
       fhir:system [ fhir:v "http://hl7.org/fhir/fhir-types"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "MedicationDispense" ]
     ] ;
     fhir:title [ fhir:v "The dispense" ] ;
     fhir:description [ fhir:v "What the unit writes back, naming itself as `performer` and the order in `authorizingPrescription`." ] ;
     fhir:content [
       fhir:link <http://costateixeira.github.io/spenser/MedicationDispense/DispenseForTaskOrder> ;
       fhir:reference [ fhir:v "MedicationDispense/DispenseForTaskOrder" ]
     ]
  ] ) ; # 
  fhir:process ( [
     fhir:title [ fhir:v "Order a chocolate through an order server" ] ;
     fhir:description [ fhir:v "Place the work, let the unit find it, and read back what it did." ] ;
     fhir:preConditions [ fhir:v "The unit has been pointed at the order server and its polling is on. The unit has written its own Device on the server, so a Task can name it." ] ;
     fhir:postConditions [ fhir:v "A chocolate has been dispensed, the dispense is on the server, the Task is completed, and the order is closed." ] ;
     fhir:step ( [
       fhir:number [ fhir:v "1" ] ;
       fhir:operation [
         fhir:type [
           fhir:system [ fhir:v "http://hl7.org/fhir/restful-interaction"^^xsd:anyURI ] ;
           fhir:code [ fhir:v "create" ]
         ] ;
         fhir:title [ fhir:v "POST /MedicationRequest" ] ;
         fhir:initiator [ fhir:v "placer" ] ;
         fhir:receiver [ fhir:v "server" ] ;
         fhir:description [ fhir:v "Nothing happens yet, and that is the point." ] ;
         fhir:initiatorActive [ fhir:v true ] ;
         fhir:receiverActive [ fhir:v true ] ;
         fhir:request [
           fhir:instanceReference [ fhir:v "order" ] ;
           fhir:versionReference [ fhir:v "order-active" ]
         ]
       ]
     ] [
       fhir:number [ fhir:v "2" ] ;
       fhir:operation [
         fhir:type [
           fhir:system [ fhir:v "http://hl7.org/fhir/restful-interaction"^^xsd:anyURI ] ;
           fhir:code [ fhir:v "create" ]
         ] ;
         fhir:title [ fhir:v "POST /Task" ] ;
         fhir:initiator [ fhir:v "placer" ] ;
         fhir:receiver [ fhir:v "server" ] ;
         fhir:description [ fhir:v "`code` is `fulfill`, `focus` is the order, `requestedPerformer` is the unit. Leave `requestedPerformer` out and any unit polling that server may take it." ] ;
         fhir:initiatorActive [ fhir:v true ] ;
         fhir:receiverActive [ fhir:v true ] ;
         fhir:request [
           fhir:instanceReference [ fhir:v "task" ] ;
           fhir:versionReference [ fhir:v "task-requested" ]
         ]
       ] ;
       fhir:alternative ( [
         fhir:title [ fhir:v "Tag the order instead of creating a Task" ] ;
         fhir:description [ fhir:v "Put `actionable` from common-tags in the order's `meta.tag` and skip the Task. A unit accepts both routes on every check, and `orderMode` narrows it to one. With no Task coordinating the work the unit completes the MedicationRequest itself, and step 6 does not happen." ]
       ] )
     ] [
       fhir:number [ fhir:v "3" ] ;
       fhir:operation [
         fhir:type [
           fhir:system [ fhir:v "http://hl7.org/fhir/restful-interaction"^^xsd:anyURI ] ;
           fhir:code [ fhir:v "search-type" ]
         ] ;
         fhir:title [ fhir:v "GET /Task" ] ;
         fhir:initiator [ fhir:v "spenser" ] ;
         fhir:receiver [ fhir:v "server" ] ;
         fhir:description [ fhir:v "`GET /Task?status=requested&_include=Task:focus&_count=5`. The unit polls on a timer, and a check can also be asked for by hand. Each check looks at the first five results only, so a long queue on the server can outrun one check. The unit remembers what it has already dealt with." ] ;
         fhir:initiatorActive [ fhir:v true ] ;
         fhir:receiverActive [ fhir:v true ] ;
         fhir:response [
           fhir:instanceReference [ fhir:v "task" ] ;
           fhir:versionReference [ fhir:v "task-requested" ]
         ]
       ]
     ] [
       fhir:number [ fhir:v "4" ] ;
       fhir:operation [
         fhir:type [
           fhir:system [ fhir:v "http://hl7.org/fhir/restful-interaction"^^xsd:anyURI ] ;
           fhir:code [ fhir:v "create" ]
         ] ;
         fhir:title [ fhir:v "POST /MedicationDispense" ] ;
         fhir:initiator [ fhir:v "spenser" ] ;
         fhir:receiver [ fhir:v "server" ] ;
         fhir:description [ fhir:v "The servo turns and a piece drops out, and then the unit says so. The write is queued and retried, so a server that was briefly unreachable does not cost the record." ] ;
         fhir:initiatorActive [ fhir:v true ] ;
         fhir:receiverActive [ fhir:v true ] ;
         fhir:request [
           fhir:instanceReference [ fhir:v "dispense" ]
         ]
       ] ;
       fhir:alternative ( [
         fhir:title [ fhir:v "The lane is empty" ] ;
         fhir:description [ fhir:v "The unit writes a dispense with `status` of `declined` and `notPerformedReason.concept` of `outofstock`. Whether the Task is then left open, so a refill retries it, or closed as failed, is the unit's `keepOrders` setting." ]
       ] )
     ] [
       fhir:number [ fhir:v "5" ] ;
       fhir:operation [
         fhir:type [
           fhir:system [ fhir:v "http://hl7.org/fhir/restful-interaction"^^xsd:anyURI ] ;
           fhir:code [ fhir:v "update" ]
         ] ;
         fhir:title [ fhir:v "PUT /Task" ] ;
         fhir:initiator [ fhir:v "spenser" ] ;
         fhir:receiver [ fhir:v "server" ] ;
         fhir:description [ fhir:v "`PUT /Task/<id>`: `status` becomes `completed`, with the dispense in `Task.output`. Sent with `If-Match`, so a Task somebody else has moved on is not overwritten." ] ;
         fhir:initiatorActive [ fhir:v true ] ;
         fhir:receiverActive [ fhir:v true ] ;
         fhir:request [
           fhir:instanceReference [ fhir:v "task" ] ;
           fhir:versionReference [ fhir:v "task-completed" ]
         ]
       ]
     ] [
       fhir:number [ fhir:v "6" ] ;
       fhir:operation [
         fhir:type [
           fhir:system [ fhir:v "http://hl7.org/fhir/restful-interaction"^^xsd:anyURI ] ;
           fhir:code [ fhir:v "update" ]
         ] ;
         fhir:title [ fhir:v "PUT /MedicationRequest" ] ;
         fhir:initiator [ fhir:v "placer" ] ;
         fhir:receiver [ fhir:v "server" ] ;
         fhir:description [ fhir:v "`PUT /MedicationRequest/<id>`. The placer closes its own order. The unit does not: it was asked to fill one Task, and it has no way of knowing whether the order authorized more than that." ] ;
         fhir:initiatorActive [ fhir:v true ] ;
         fhir:receiverActive [ fhir:v true ] ;
         fhir:request [
           fhir:instanceReference [ fhir:v "order" ] ;
           fhir:versionReference [ fhir:v "order-completed" ]
         ]
       ]
     ] )
  ] ) . # 

