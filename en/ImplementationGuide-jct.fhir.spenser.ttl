       ] ;
       fhir:name [ fhir:v "Example - Spenser Request" ] ;
       fhir:description [ fhir:v "Example of a MedicationRequest to send to Spenser" ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
