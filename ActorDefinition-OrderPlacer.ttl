         fhir:url [ fhir:v "content"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Op een orderserver beslist de plaatser of een order uitvoerbaar is, door de MedicationRequest een tag te geven of door een Task aan te maken die ernaar verwijst. Als een Task het werk coördineert, sluit de plaatser ook de MedicationRequest af zodra de Task is voltooid."
         ]
       ] ) ;
       fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/translation"^^xsd:anyURI ]
