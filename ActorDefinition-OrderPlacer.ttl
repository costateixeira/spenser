  fhir:documentation [
     fhir:v "On an Order Server, the placer decides whether an order is actionable, either by tagging the MedicationRequest or by creating a Task that points at it. When a Task coordinates the work, the placer also closes the MedicationRequest once the Task is completed." ;
     fhir:extension ( [
       fhir:extension ( [
         fhir:url [ fhir:v "lang"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:code ;
           fhir:v "pt"
