    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="MedicationRequest"/>
      </extension>
      <reference>
        <reference value="MedicationRequest/med-request-1234"/>
      </reference>
      <name value="Voorbeeld - Spenser-aanvraag"/>
      <description value="Voorbeeld van een MedicationRequest om naar Spenser te sturen"/>
      <isExample value="true"/>
      <profile value="http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="MedicationRequest"/>
      </extension>
      <reference>
        <reference value="MedicationRequest/ActionableDarkOrderForOneUnit"/>
      </reference>
      <name value="Example - Tagged order for one unit"/>
      <description value="An order made actionable by the tag, with no Task, that names the unit to dispense it in the dispensingDevice extension. Every other unit polling the server skips it."/>
      <isExample value="true"/>
      <profile value="http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
      </extension>
      <reference>
        <reference value="Task/FulfillForOneUnit"/>
      </reference>
      <name value="Example - Task addressed to one unit"/>
      <description value="Task.requestedPerformer names the unit that is to fill the order: the one Task element R5 lets name a Device. Every other unit skips this Task; the unit it names dispenses it and closes it."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Task"/>
      </extension>
      <reference>
        <reference value="Task/FulfillPlainMilkOrder"/>
      </reference>
      <name value="Voorbeeld - Task die vraagt om een order uit te voeren"/>
      <description value="Een coördinerende Task die in Task.focus naar de order verwijst. Dit maakt de gewone order uitvoerbaar. Spenser voltooit de Task met de verstrekking in Task.output, en laat de aanvraag zelf aan de plaatser over."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="ActorDefinition"/>
      </extension>
      <reference>
        <reference value="ActorDefinition/OrderPlacer"/>
      </reference>
      <name value="Orderplaatser"/>
      <description value="Het systeem dat om chocolade vraagt, door een order naar een Spenser-unit te posten of er een op een orderserver te plaatsen."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="ActorDefinition"/>
      </extension>
      <reference>
        <reference value="ActorDefinition/OrderServer"/>
      </reference>
