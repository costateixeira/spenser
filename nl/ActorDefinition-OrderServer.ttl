     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"nl\" lang=\"nl\"><hr/><p><b>Dutch</b></p><hr/><p class=\"res-header-id\"><b>Gegenereerde narrative: ActorDefinition OrderServer</b></p><a name=\"nl-OrderServer\"> </a><a name=\"nl-hcOrderServer\"> </a><table class=\"grid\"><tr><td><b>Actor: OrderServer </b></td><td>Orderserver</td><td>Type: system </td></tr><tr><td colspan=\"3\"><div><p>Answers the unit's searches for tagged MedicationRequests and for requested Tasks, including <code>_include=Task:focus</code>. Accepts the MedicationDispense the unit creates and the updates it makes to the Task or MedicationRequest.</p>\n<p>See <a href=\"interfaces.html#what-spenser-asks-of-an-order-server\">What Spenser asks of an order server</a>.</p>\n</div></td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
