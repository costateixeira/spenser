  fhir:publisher [ fhir:v "José Costa Teixeira"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "José Costa Teixeira" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://github.com/costateixeira" ]
     ] )
  ] [
     fhir:name [ fhir:v "José Costa Teixeira" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "email" ] ;
       fhir:value [ fhir:v "you-know.it@gmail.com" ] ;
       fhir:use [ fhir:v "work" ]
     ] )
  ] ) ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "http://unstats.un.org/unsd/methods/m49/m49.htm"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "001" ] ;
       fhir:display [ fhir:v "World" ]
     ] )
  ] ) ; # 
  fhir:kind [ fhir:v "instance"] ; # 
  fhir:implementation [
     fhir:description [ fhir:v "Spenser FHIR Endpoint" ]
  ] ; # 
  fhir:fhirVersion [ fhir:v "5.0.0"] ; # 
  fhir:format ( [ fhir:v "json"] ) ; # 
  fhir:rest ( [
     fhir:mode [ fhir:v "server" ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "MedicationRequest" ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "create" ]
       ] )
     ] [
       fhir:type [ fhir:v "MedicationDispense" ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] )
     ] [
       fhir:type [ fhir:v "InventoryReport" ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ]
       ] [
         fhir:code [ fhir:v "create" ]
       ] )
     ] )
  ] [
     fhir:mode [ fhir:v "client" ] ;
     fhir:documentation [ fhir:v "Spenser also acts as a client: it polls a server for orders it should fulfil. Following the COW guidance on actionable orders, an order is only dispensed when the MedicationRequest carries the 'actionable' tag, or when a Task asks for it to be fulfilled." ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "MedicationRequest" ] ;
       fhir:documentation [ fhir:v "Searched for orders tagged as actionable. Set to 'completed' after dispensing, when no Task is coordinating the work." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "search-type" ]
       ] [
         fhir:code [ fhir:v "update" ]
       ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "_tag" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Selects orders tagged http://terminology.hl7.org/CodeSystem/common-tags#actionable" ]
       ] [
         fhir:name [ fhir:v "status" ] ;
         fhir:type [ fhir:v "token" ]
       ] [
         fhir:name [ fhir:v "intent" ] ;
         fhir:type [ fhir:v "token" ]
       ] )
     ] [
       fhir:type [ fhir:v "Task" ] ;
       fhir:documentation [ fhir:v "Coordination Task pointing at the order in Task.focus. Set to 'completed' with the dispense in Task.output; the status of the request itself is left to the placer." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "search-type" ]
       ] [
         fhir:code [ fhir:v "update" ]
       ] ) ;
       fhir:searchInclude ( [ fhir:v "Task:focus" ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "status" ] ;
         fhir:type [ fhir:v "token" ]
       ] )
     ] [
       fhir:type [ fhir:v "MedicationDispense" ] ;
       fhir:documentation [ fhir:v "Created on the server once an order has been dispensed, referring to the order in authorizingPrescription." ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "create" ]
       ] )
     ] )
  ] ) . # 

