# - resource -------------------------------------------------------------------

<http://costateixeira.github.io/spenser/CapabilityStatement/SpenserFHIRCapabilityStatement> a fhir:CapabilityStatement ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "SpenserFHIRCapabilityStatement"] ; # 
  fhir:language [ fhir:v "nl"] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"nl\" lang=\"nl\"><hr/><p><b>Dutch</b></p><hr/><p class=\"res-header-id\"><b>Gegenereerde narrative: CapabilityStatement SpenserFHIRCapabilityStatement</b></p><a name=\"nl-SpenserFHIRCapabilityStatement\"> </a><a name=\"nl-hcSpenserFHIRCapabilityStatement\"> </a><h2 id=\"nl-title\"/><ul><li>Implementatiegids versie: 1.0.0 </li><li>FHIR versie: 5.0.0 </li><li>Ondersteunde formaten: <code>json</code></li><li>Gepubliceerd: 2025-04-18 </li><li>Gepubliceerd door: José Costa Teixeira </li></ul><blockquote class=\"impl-note\"><p><strong>Noot aan implementers: FHIR Capabilities</strong></p><p>Elke FHIR functie is 'toegestaan' door het systeem tenzij epxliciet gemarkeerd als 'MOET NIET'. Er zijn mogelijk een paar dingen gemarkeerd als MAG in de implementatiegids om hun mogelijke relevantie voor de usecase te benadrukken.</p></blockquote><h2 id=\"nl-rest\">FHIR RESTful Capabilities</h2><h3 id=\"nl-rest1\">REST configuratie: 1 </h3><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"nl-mode1\" class=\"panel-title\">Mode: <code>server</code></h4></div><div class=\"panel-body\"/></div><h4 id=\"nl-resourcesCap1\">Capabilities op Resource/Profiel</h4><h5 id=\"nl-resourcesSummary1\">Samenvatting</h5><p>De samenvattingtabel bevat de resources die deel van deze configuratie zijn en voor iedere resource in de tabel:</p><ul><li>De relevante profielen (indien aanwezig)</li><li>De interacties ondersteund bij iedere resource (<b><span class=\"bg-info\">R</span></b>ead, <b><span class=\"bg-info\">S</span></b>earch, <b><span class=\"bg-info\">U</span></b>pdate, and <b><span class=\"bg-info\">C</span></b>reate, are always shown, while <b><span class=\"bg-info\">VR</span></b>ead, <b><span class=\"bg-info\">P</span></b>atch, <b><span class=\"bg-info\">D</span></b>elete, <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">I</span></b>nstance, or <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">T</span></b>type is alleen aanwezig als temninste één van de resources deze ondersteunt.</li><li><span>De verplichte, aanbevolen en bepaalde optionele parameters (indien aanwezig). </span></li><li>De gekoppelde resources actief voor <code>_include</code></li><li>De andere resources actief voor <code>_revinclude</code></li><li>De operations op de resource (indien aanwezig)</li></ul><div class=\"table-responsive\"><table class=\"table table-condensed table-hover\"><thead><tr><th><b>Resource type</b></th><th><b>Profiel</b></th><th class=\"text-center\"><b title=\"GET een resource (read interactie)\">R</b></th><th class=\"text-center\"><b title=\"GET set resources van het type (zoek interactie)\">S</b></th><th class=\"text-center\"><b title=\"PUT een nieuwe resource versie (update interactie)\">U</b></th><th class=\"text-center\"><b title=\"POST een nieuwe resource (maak interactie)\">C</b></th><th><b title=\"Verplichte en aanbevolen zoekparameters\">Zoekacties</b></th><th><code><b>_include</b></code></th><th><code><b>_revinclude</b></code></th><th><b>Operations</b></th></tr></thead><tbody><tr><td><a href=\"#nl-MedicationRequest1-1\">MedicationRequest</a></td><td> </td><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\">y</td><td/><td/><td/><td/></tr><tr><td><a href=\"#nl-MedicationDispense1-2\">MedicationDispense</a></td><td> </td><td class=\"text-center\">y</td><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\"/><td/><td/><td/><td/></tr><tr><td><a href=\"#nl-InventoryReport1-3\">InventoryReport</a></td><td> </td><td class=\"text-center\">y</td><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\">y</td><td/><td/><td/><td/></tr></tbody></table></div><hr/><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"nl-MedicationRequest1-1\" class=\"panel-title\"><span style=\"float: right;\">Resource conformance: unspecified </span>MedicationRequest</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Core FHIR resource</span><br/><a href=\"http://hl7.org/fhir/medicationrequest.html\">MedicationRequest</a></div><div class=\"col-lg-4\"><span class=\"lead\">Referentiebeleid</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Interactie samenvatting</span><br/><ul><li>Ondersteunt <code>create</code>.</li></ul></div></div><p/><p/></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"nl-MedicationDispense1-2\" class=\"panel-title\"><span style=\"float: right;\">Resource conformance: unspecified </span>MedicationDispense</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Core FHIR resource</span><br/><a href=\"http://hl7.org/fhir/medicationdispense.html\">MedicationDispense</a></div><div class=\"col-lg-4\"><span class=\"lead\">Referentiebeleid</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Interactie samenvatting</span><br/><ul><li>Ondersteunt <code>read</code>.</li></ul></div></div><p/><p/></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"nl-InventoryReport1-3\" class=\"panel-title\"><span style=\"float: right;\">Resource conformance: unspecified </span>InventoryReport</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Core FHIR resource</span><br/><a href=\"http://hl7.org/fhir/inventoryreport.html\">InventoryReport</a></div><div class=\"col-lg-4\"><span class=\"lead\">Referentiebeleid</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Interactie samenvatting</span><br/><ul><li>Ondersteunt <code>read</code>, <code>create</code>.</li></ul></div></div><p/><p/></div></div></div><h3 id=\"nl-rest2\">REST configuratie: 2 </h3><div class=\"panel panel-default\"><div class=\"panel-heading\"><h4 id=\"nl-mode2\" class=\"panel-title\">Mode: <code>client</code></h4></div><div class=\"panel-body\"><div><p>Spenser also acts as a client: it polls a server for orders it should fulfil. Following the COW guidance on actionable orders, an order is only dispensed when the MedicationRequest carries the 'actionable' tag, or when a Task asks for it to be fulfilled.</p>\n</div></div></div><h4 id=\"nl-resourcesCap2\">Capabilities op Resource/Profiel</h4><h5 id=\"nl-resourcesSummary2\">Samenvatting</h5><p>De samenvattingtabel bevat de resources die deel van deze configuratie zijn en voor iedere resource in de tabel:</p><ul><li>De relevante profielen (indien aanwezig)</li><li>De interacties ondersteund bij iedere resource (<b><span class=\"bg-info\">R</span></b>ead, <b><span class=\"bg-info\">S</span></b>earch, <b><span class=\"bg-info\">U</span></b>pdate, and <b><span class=\"bg-info\">C</span></b>reate, are always shown, while <b><span class=\"bg-info\">VR</span></b>ead, <b><span class=\"bg-info\">P</span></b>atch, <b><span class=\"bg-info\">D</span></b>elete, <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">I</span></b>nstance, or <b><span class=\"bg-info\">H</span></b>istory on <b><span class=\"bg-info\">T</span></b>type is alleen aanwezig als temninste één van de resources deze ondersteunt.</li><li><span>De verplichte, aanbevolen en bepaalde optionele parameters (indien aanwezig). </span></li><li>De gekoppelde resources actief voor <code>_include</code></li><li>De andere resources actief voor <code>_revinclude</code></li><li>De operations op de resource (indien aanwezig)</li></ul><div class=\"table-responsive\"><table class=\"table table-condensed table-hover\"><thead><tr><th><b>Resource type</b></th><th><b>Profiel</b></th><th class=\"text-center\"><b title=\"GET een resource (read interactie)\">R</b></th><th class=\"text-center\"><b title=\"GET set resources van het type (zoek interactie)\">S</b></th><th class=\"text-center\"><b title=\"PUT een nieuwe resource versie (update interactie)\">U</b></th><th class=\"text-center\"><b title=\"POST een nieuwe resource (maak interactie)\">C</b></th><th><b title=\"Verplichte en aanbevolen zoekparameters\">Zoekacties</b></th><th><code><b>_include</b></code></th><th><code><b>_revinclude</b></code></th><th><b>Operations</b></th></tr></thead><tbody><tr><td><a href=\"#nl-MedicationRequest2-1\">MedicationRequest</a></td><td> </td><td class=\"text-center\"/><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\"/><td>_tag, status, intent</td><td/><td/><td/></tr><tr><td><a href=\"#nl-Task2-2\">Task</a></td><td> </td><td class=\"text-center\"/><td class=\"text-center\">y</td><td class=\"text-center\">y</td><td class=\"text-center\"/><td>status</td><td><code>Task:focus</code></td><td/><td/></tr><tr><td><a href=\"#nl-MedicationDispense2-3\">MedicationDispense</a></td><td> </td><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\"/><td class=\"text-center\">y</td><td/><td/><td/><td/></tr></tbody></table></div><hr/><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"nl-MedicationRequest2-1\" class=\"panel-title\"><span style=\"float: right;\">Resource conformance: unspecified </span>MedicationRequest</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Core FHIR resource</span><br/><a href=\"http://hl7.org/fhir/medicationrequest.html\">MedicationRequest</a></div><div class=\"col-lg-4\"><span class=\"lead\">Referentiebeleid</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Interactie samenvatting</span><br/><ul><li>Ondersteunt <code>search-type</code>, <code>update</code>.</li></ul></div></div><p/><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Documentatie</span><blockquote><div><p>Searched for orders tagged as actionable. Set to 'completed' after dispensing, when no Task is coordinating the work.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Zoekparameters</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Conformance</th><th>Parameter</th><th>Type</th><th>Documentatie</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td>_tag</td><td><code>token</code></td><td><div><p>Selects orders tagged http://terminology.hl7.org/CodeSystem/common-tags#actionable</p>\n</div></td></tr><tr><td><b>SHALL</b></td><td>status</td><td><code>token</code></td><td><div/></td></tr><tr><td><b>SHALL</b></td><td>intent</td><td><code>token</code></td><td><div/></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"nl-Task2-2\" class=\"panel-title\"><span style=\"float: right;\">Resource conformance: unspecified </span>Task</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Core FHIR resource</span><br/><a href=\"http://hl7.org/fhir/task.html\">Task</a></div><div class=\"col-lg-4\"><span class=\"lead\">Referentiebeleid</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Interactie samenvatting</span><br/><ul><li>Ondersteunt <code>search-type</code>, <code>update</code>.</li></ul></div></div><p/><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Documentatie</span><blockquote><div><p>Coordination Task pointing at the order in Task.focus. Set to 'completed' with the dispense in Task.output; the status of the request itself is left to the placer.</p>\n</div></blockquote></div></div><div class=\"row\"><div class=\"col-lg-7\"><span class=\"lead\">Zoekparameters</span><table class=\"table table-condensed table-hover\"><thead><tr><th>Conformance</th><th>Parameter</th><th>Type</th><th>Documentatie</th></tr></thead><tbody><tr><td><b>SHALL</b></td><td>status</td><td><code>token</code></td><td><div/></td></tr></tbody></table></div><div class=\"col-lg-5\"> </div></div></div></div></div><div class=\"panel panel-default\"><div class=\"panel-heading\"><h5 id=\"nl-MedicationDispense2-3\" class=\"panel-title\"><span style=\"float: right;\">Resource conformance: unspecified </span>MedicationDispense</h5></div><div class=\"panel-body\"><div class=\"container\"><div class=\"row\"><div class=\"col-lg-4\"><span class=\"lead\">Core FHIR resource</span><br/><a href=\"http://hl7.org/fhir/medicationdispense.html\">MedicationDispense</a></div><div class=\"col-lg-4\"><span class=\"lead\">Referentiebeleid</span><br/></div><div class=\"col-lg-4\"><span class=\"lead\">Interactie samenvatting</span><br/><ul><li>Ondersteunt <code>create</code>.</li></ul></div></div><p/><p/><div class=\"row\"><div class=\"col-12\"><span class=\"lead\">Documentatie</span><blockquote><div><p>Created on the server once an order has been dispensed, referring to the order in authorizingPrescription.</p>\n</div></blockquote></div></div></div></div></div></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "http://costateixeira.github.io/spenser/CapabilityStatement/SpenserFHIRCapabilityStatement"^^xsd:anyURI] ; # 
